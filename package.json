{
  "name": "react-component-library-monorepo",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "packageManager": "pnpm@9.1.4",
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
    "build": "pnpm --filter @syntropic137/design-tokens tokens:build && pnpm -r build",
    "test:verify": "node --test scripts/verify-design-system.test.mjs scripts/package-publish.test.mjs scripts/release-gate.test.mjs",
    "qa": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm design-system:verify && pnpm test:verify && pnpm storybook:test",
    "check": "pnpm qa",
    "storybook": "pnpm --filter @syntropic137/default-react-v18 storybook",
    "storybook:build": "pnpm --filter @syntropic137/default-react-v18 storybook:build",
    "storybook:test": "pnpm --filter @syntropic137/default-react-v18 storybook:test",
    "storybook:svelte": "pnpm --filter @syntropic137/default-svelte-v5 storybook",
    "test:svelte": "pnpm --filter @syntropic137/default-svelte-v5 test",
    "generate:component": "pnpm --filter @syntropic137/component-generator build && node packages/dev-tools/component-generator/dist/cli.js",
    "tui": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/dev-tools/dashboard/src/cli.ts",
    "design-system:verify": "node scripts/verify-design-system.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "publish:packages": "node scripts/publish-packages.mjs",
    "release:gate": "node scripts/release-gate.mjs"
  },
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-storybook": "^10.4.4",
    "globals": "^17.6.0",
    "prettier": "^3.6.2",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "^7.29.6",
      "@vitest/browser-playwright@<4.1.11": ">=4.1.11 <5",
      "@vitest/browser@<4.1.11": ">=4.1.11 <5",
      "@vitest/mocker@<4.1.11": ">=4.1.11 <5",
      "ajv@>=8.0.0 <8.18.0": ">=8.18.0",
      "baseline-browser-mapping@<2.11.0": ">=2.11.0 <3",
      "brace-expansion@<2": ">=1.1.21 <2",
      "brace-expansion@>=2 <3": ">=2.0.3 <3",
      "brace-expansion@>=3": ">=5.0.12 <6",
      "browserslist@<4.28.7": ">=4.28.7 <5",
      "colord@<2.9.4": ">=2.9.4 <3",
      "devalue@<5.9.3": ">=5.9.3 <6",
      "esbuild@<0.25.0": ">=0.25.0",
      "fast-uri@>=3.0.0 <3.1.8": ">=3.1.8 <4",
      "form-data": "^4.0.6",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2 <5",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "nanoid@>=3.0.0 <3.3.18": ">=3.3.18 <4",
      "postcss-selector-parser@>=7.0.0 <7.1.6": ">=7.1.6 <8",
      "postcss@<8.5.23": ">=8.5.23 <9",
      "source-map-js@<1.2.2": ">=1.2.2 <2",
      "vitest@<4.1.11": ">=4.1.11 <5"
    }
  }
}
