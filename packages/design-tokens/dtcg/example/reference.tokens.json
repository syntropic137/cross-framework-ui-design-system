          ],
          "hex": "#F87171"
        }
      },
      "scrim-dark": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0588,
            0.0667,
            0.0824
          ],
          "alpha": 0.72,
          "hex": "#0F1115"
        }
      },
      "scrim-light": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
