  },
  "gradient": {
    "$type": "gradient",
    "blue": {
      "$value": [
        {
          "color": "{color.palette.blue-600}",
          "position": 0
        },
        {
          "color": "{color.palette.blue-400}",
          "position": 1
        }
      ]
    }
  },
  "space": {
    "1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "5": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "6": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "$type": "dimension"
  },
  "size": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    }
  },
  "duration": {
    "$type": "duration",
    "ui": {
      "$value": {
        "value": 150,
        "unit": "ms"
      }
    },
    "slow": {
      "$value": {
        "value": 300,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "sm": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 18,
          "unit": "px"
        }
      },
      "xl": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      }
    }
  },
  "typography": {
    "$type": "typography",
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": 1.4,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xl}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": 1.25,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "numeric": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      },
      "$extensions": {
        "com.syntropic137.typography": {
          "fontFeatures": [
            "tnum",
            "lnum"
          ]
        }
      }
    }
  }
}
