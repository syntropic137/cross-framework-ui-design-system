{
  "name": "@syntropic137/design-tokens",
  "version": "0.1.0",
  "description": "Design tokens for the Syntropic137 cross-framework design system: layered --ds-* CSS custom properties, a JSON snapshot and a typed token name list. Zero runtime dependencies.",
  "keywords": [
    "design-system",
    "design-tokens",
    "css-custom-properties",
    "theming"
  ],
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "!dist/**/*.tsbuildinfo",
    "generated/design-tokens.css",
    "generated/design-tokens.json"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json && node ./dist/cli.js",
    "clean": "rimraf dist generated",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "tokens:build": "pnpm build && node ./dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "eslint": "^9.39.4",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./names": {
      "types": "./dist/names.d.ts",
      "default": "./dist/names.js"
    },
    "./css": "./generated/design-tokens.css",
    "./generated/design-tokens.css": "./generated/design-tokens.css",
    "./generated/design-tokens.json": "./generated/design-tokens.json",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syntropic137/cross-framework-ui-design-system.git",
    "directory": "packages/design-tokens"
  },
  "license": "MIT",
  "homepage": "https://github.com/syntropic137/cross-framework-ui-design-system/tree/main/packages/design-tokens#readme",
  "bugs": {
    "url": "https://github.com/syntropic137/cross-framework-ui-design-system/issues"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
