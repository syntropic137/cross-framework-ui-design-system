{
  "name": "@syntropic137/design-contracts",
  "version": "0.1.0",
  "description": "Framework-neutral component API contracts for the Syntropic137 cross-framework design system. Zero runtime dependencies.",
  "keywords": [
    "design-system",
    "component-contracts",
    "typescript",
    "svelte",
    "react"
  ],
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "design-system-verify": "./bin/verify-design-system.mjs"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syntropic137/cross-framework-ui-design-system.git",
    "directory": "packages/contracts"
  },
  "license": "MIT",
  "homepage": "https://github.com/syntropic137/cross-framework-ui-design-system/tree/main/packages/contracts#readme",
  "bugs": {
    "url": "https://github.com/syntropic137/cross-framework-ui-design-system/issues"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
